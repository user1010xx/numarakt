# Railway Variables / local .env — gerçek değerleri buraya YAZMAYIN
# Bu dosya sadece isim şablonudur.

# Zorunlu
TELEGRAM_BOT_TOKEN=
TONIVA_API_KEY=

# Opsiyonel (varsayılan: production public API)
TONIVA_BASE_URL=https://crm.toniva.net/api/public/v1

# Opsiyonel: sadece bu Telegram gruplarında çalışsın (virgülle)
# ALLOWED_CHAT_IDS=

# Zaman dilimi + arama penceresi
TZ=Europe/Istanbul
LOOKBACK_DAYS=30

# Yerel SQLite önbellek (numara ile anında arama)
CACHE_PATH=data/calls.db
# Arka plan senkron (API'yi yorar) — varsayılan kapalı
CACHE_SYNC_ON_START=false
